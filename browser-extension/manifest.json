{
  "manifest_version": 3,
  "name": "Mangar Downloader",
  "version": "1.0.1",
  "minimum_chrome_version": "132",
  "description": "Передача текущей страницы или медиапотока в локальный Mangar Downloader для скачивания",
  "key": "",
  "permissions": [
    "webRequest",
    "cookies",
    "storage",
    "tabs",
    "webNavigation",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Mangar Downloader"
  }
}
